# Supabase — używane WYŁĄCZNIE do logowania (zdobycie JWT).
# Dane lecą przez backend REST (/api/v1), nie bezpośrednio z supabase-js.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Bazowy URL API. W devie zostaw puste — Vite proxy kieruje /api → :8000.
# Na prod ustaw np. https://api.twojadomena.pl
VITE_API_BASE_URL=
